class PhishingAnalyzer(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("DecodeLabs | Phishing Awareness Analyzer - Project 3")
        self.geometry("1180x760")
        self.configure(bg=BG)
        self.minsize(1000, 680)
        self._build_ui()

    # ------------------------------------------------------------------
    def _build_ui(self):
        header = tk.Frame(self, bg=BG)
        header.pack(fill="x", padx=24, pady=(20, 10))

        tk.Label(header, text="Phishing Awareness Analyzer", font=FONT_TITLE,
                 bg=BG, fg=TEXT).pack(anchor="w")
        tk.Label(header,
                 text="DecodeLabs Project 3  \u2022  Detection Phase  \u2022  Heuristic Triage Simulation "
                      "(not a live threat-intel feed)",
                 font=FONT_SUB, bg=BG, fg=SUBTEXT).pack(anchor="w", pady=(2, 0))

        body = tk.Frame(self, bg=BG)
        body.pack(fill="both", expand=True, padx=24, pady=10)
        body.columnconfigure(0, weight=1)
        body.columnconfigure(1, weight=1)
        body.rowconfigure(0, weight=1)

        # ---------------- LEFT: input panel ----------------
        left = tk.Frame(body, bg=PANEL, highlightbackground=BORDER,
                         highlightthickness=1)
        left.grid(row=0, column=0, sticky="nsew", padx=(0, 10))

        tk.Label(left, text="1. Paste Email / Message Content", font=FONT_LABEL,
                 bg=PANEL, fg=TEAL).pack(anchor="w", padx=16, pady=(16, 4))
        tk.Label(left, text="Include headers (From, Subject) and body text for best accuracy.",
                 font=FONT_SUB, bg=PANEL, fg=SUBTEXT).pack(anchor="w", padx=16)

        sample_row = tk.Frame(left, bg=PANEL)
        sample_row.pack(fill="x", padx=16, pady=(10, 4))
        tk.Label(sample_row, text="Load sample:", font=FONT_SUB, bg=PANEL, fg=SUBTEXT).pack(side="left")
        self.sample_var = tk.StringVar(value="-- Select a sample --")
        sample_menu = ttk.Combobox(sample_row, textvariable=self.sample_var,
                                    values=list(SAMPLE_EMAILS.keys()), state="readonly", width=32)
        sample_menu.pack(side="left", padx=8)
        sample_menu.bind("<<ComboboxSelected>>", self._load_sample)

        self.input_box = scrolledtext.ScrolledText(
            left, wrap="word", font=FONT_BODY, bg=CARD, fg=TEXT,
            insertbackground=TEXT, relief="flat", padx=10, pady=10)
        self.input_box.pack(fill="both", expand=True, padx=16, pady=10)

        btn_row = tk.Frame(left, bg=PANEL)
        btn_row.pack(fill="x", padx=16, pady=(0, 16))
        analyze_btn = tk.Button(btn_row, text="Analyze Message", font=FONT_LABEL,
                                 bg=EMERALD, fg="#04211a", activebackground=TEAL,
                                 relief="flat", padx=18, pady=8, cursor="hand2",
                                 command=self.analyze)
        analyze_btn.pack(side="left")
        clear_btn = tk.Button(btn_row, text="Clear", font=FONT_SUB,
                               bg=CARD, fg=TEXT, activebackground=BORDER,
                               relief="flat", padx=14, pady=8, cursor="hand2",
                               command=self._clear)
        clear_btn.pack(side="left", padx=8)

        # ---------------- RIGHT: results panel ----------------
        right = tk.Frame(body, bg=PANEL, highlightbackground=BORDER,
                          highlightthickness=1)
        right.grid(row=0, column=1, sticky="nsew", padx=(10, 0))

        tk.Label(right, text="2. Triage Result", font=FONT_LABEL,
                 bg=PANEL, fg=TEAL).pack(anchor="w", padx=16, pady=(16, 4))

        self.verdict_frame = tk.Frame(right, bg=CARD, highlightthickness=2,
                                       highlightbackground=BORDER)
        self.verdict_frame.pack(fill="x", padx=16, pady=(6, 10))
        self.verdict_label = tk.Label(self.verdict_frame, text="Awaiting analysis...",
                                       font=FONT_VERDICT, bg=CARD, fg=SUBTEXT, pady=14)
        self.verdict_label.pack(fill="x")
        self.action_label = tk.Label(self.verdict_frame, text="", font=FONT_SUB,
                                      bg=CARD, fg=SUBTEXT, pady=(0))
        self.action_label.pack(fill="x", pady=(0, 12))

        tk.Label(right, text="Detected Red Flags", font=FONT_LABEL,
                 bg=PANEL, fg=TEXT).pack(anchor="w", padx=16, pady=(6, 4))

        canvas_frame = tk.Frame(right, bg=PANEL)
        canvas_frame.pack(fill="both", expand=True, padx=16, pady=(0, 16))

        self.results_canvas = tk.Canvas(canvas_frame, bg=PANEL, highlightthickness=0)
        scrollbar = ttk.Scrollbar(canvas_frame, orient="vertical", command=self.results_canvas.yview)
        self.results_inner = tk.Frame(self.results_canvas, bg=PANEL)

        self.results_inner.bind(
            "<Configure>",
            lambda e: self.results_canvas.configure(scrollregion=self.results_canvas.bbox("all"))
        )
        self.results_canvas.create_window((0, 0), window=self.results_inner, anchor="nw")
        self.results_canvas.configure(yscrollcommand=scrollbar.set)
        self.results_canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self._render_placeholder()

    # ------------------------------------------------------------------
    def _load_sample(self, event=None):
        key = self.sample_var.get()
        text = SAMPLE_EMAILS.get(key, "")
        self.input_box.delete("1.0", "end")
        self.input_box.insert("1.0", text)

    def _clear(self):
        self.input_box.delete("1.0", "end")
        self._render_placeholder()
        self.verdict_label.config(text="Awaiting analysis...", fg=SUBTEXT)
        self.action_label.config(text="")
        self.verdict_frame.config(highlightbackground=BORDER)

    def _render_placeholder(self):
        for w in self.results_inner.winfo_children():
            w.destroy()
        tk.Label(self.results_inner, text="No message analyzed yet.\nPaste content on the "
                                           "left and click Analyze.",
                 font=FONT_SUB, bg=PANEL, fg=SUBTEXT, justify="left").pack(
            anchor="w", padx=4, pady=10)

    # ------------------------------------------------------------------
    def analyze(self):
        text = self.input_box.get("1.0", "end").strip()
        if not text:
            messagebox.showwarning("No content", "Please paste an email/message to analyze.")
            return

        for w in self.results_inner.winfo_children():
            w.destroy()

        score = 0
        hits = []
        for rid, label, weight, category, fn, explanation in RULES:
            try:
                triggered = fn(text)
            except Exception:
                triggered = False
            if triggered:
                score += weight
                hits.append((rid, label, weight, category, explanation))

        if not hits:
            tk.Label(self.results_inner, text="No red flags detected against current ruleset.",
                      font=FONT_SUB, bg=PANEL, fg=SAFE, justify="left").pack(
                anchor="w", padx=4, pady=10)
        else:
            for rid, label, weight, category, explanation in hits:
                color = MALICIOUS if weight >= 3 else (SUSPICIOUS if weight == 2 else SUBTEXT)
                card = tk.Frame(self.results_inner, bg=CARD, highlightthickness=1,
                                 highlightbackground=color)
                card.pack(fill="x", pady=5, ipady=6)
                top = tk.Frame(card, bg=CARD)
                top.pack(fill="x", padx=10, pady=(6, 0))
                tk.Label(top, text=f"{rid} \u2022 {label}", font=("Segoe UI", 10, "bold"),
                         bg=CARD, fg=TEXT).pack(side="left")
                tk.Label(top, text=category, font=("Segoe UI", 8), bg=CARD, fg=TEAL).pack(side="right")
                tk.Label(card, text=explanation, font=FONT_SUB, bg=CARD, fg=SUBTEXT,
                         wraplength=460, justify="left").pack(anchor="w", padx=10, pady=(4, 6))

        # ---- decision tree verdict ----
        if score == 0:
            verdict, color, action = "SAFE", SAFE, "Action: CLOSE - No indicators found. Standard caution still applies."
        elif score <= 4:
            verdict, color, action = "SUSPICIOUS", SUSPICIOUS, "Action: WARN USER - Pause, verify sender via a separate channel before acting."
        else:
            verdict, color, action = "MALICIOUS", MALICIOUS, "Action: BLOCK & ESCALATE - Report to security team, do not click/reply/download."

        self.verdict_label.config(text=f"{verdict}  (Risk Score: {score})", fg=color)
        self.action_label.config(text=action, fg=SUBTEXT)
        self.verdict_frame.config(highlightbackground=color)


if __name__ == "__main__":
    app = PhishingAnalyzer()
    app.mainloop()
