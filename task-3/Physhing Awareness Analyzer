# RED FLAG RULES  (mirrors the 11 red flags from the training deck)
# Each rule: (id, label, severity_weight, category, detector_fn, explanation)
# ---------------------------------------------------------------------------

def has_domain_mismatch(text):
    m = re.findall(r'From:.*?<([^>]+)>', text, re.IGNORECASE)
    display = re.findall(r'From:\s*([^<\n]+)<', text, re.IGNORECASE)
    if m and display:
        domain = m[0].split('@')[-1].lower()
        known_brands = ["microsoft", "google", "paypal", "apple", "amazon",
                         "ceo", "hr", "it support", "bank"]
        disp = display[0].lower()
        if any(b in disp for b in known_brands) and not any(
            b.replace(" ", "") in domain for b in known_brands
        ):
            return True
    return False

def has_forwarded_chain(text):
    return bool(re.search(r'\bFW:|Fwd:', text, re.IGNORECASE)) and \
           bool(re.search(r'From:.*From:', text, re.DOTALL))

def has_login_popup(text):
    return bool(re.search(r'sign in|log ?in|verify your account|confirm your password',
                           text, re.IGNORECASE))

def has_dangerous_attachment(text):
    return bool(re.search(r'\.(iso|js|scr|exe|vbs|bat|hta|jar)\b', text, re.IGNORECASE))

def has_bypass_request(text):
    return bool(re.search(r'strictly confidential|do not discuss|bypass (the )?(standard|normal) '
                           r'procedure|keep this (private|secret)', text, re.IGNORECASE))

def has_sensitive_info_request(text):
    return bool(re.search(r'\b(otp|mfa code|password|pin|cvv|account number|routing number|'
                           r'wire transfer|update.*billing)\b', text, re.IGNORECASE))

def has_activity_alert(text):
    return bool(re.search(r'unusual sign-?in|new device detected|suspicious login|'
                           r'account (locked|will be locked|suspended)', text, re.IGNORECASE))

def has_mfa_fatigue(text):
    return bool(re.search(r'approve sign-?in|multiple.*(approve|push)', text, re.IGNORECASE))

def has_callback_scam(text):
    has_phone = bool(re.search(r'call\s+\(?\d{1,3}\)?[\s-]?\d{3}[\s-]?\d{4}', text, re.IGNORECASE))
    has_link = bool(re.search(r'https?://', text, re.IGNORECASE))
    return has_phone and not has_link

def has_qr_prompt(text):
    return bool(re.search(r'qr code|scan to unlock|scan to (secure|verify)', text, re.IGNORECASE))

def has_lookalike_domain(text):
    urls = re.findall(r'https?://[^\s"\'<>]+', text)
    suspicious_patterns = [r'\d(?=[a-z])', r'-secure-', r'-login', r'-update',
                            r'-verify', r'\.tech\.', r'\.info\b', r'\.xyz\b']
    for u in urls:
        for p in suspicious_patterns:
            if re.search(p, u, re.IGNORECASE):
                return True
    return False

def has_urgency_language(text):
    cleaned = re.sub(r'non-urgent|non urgent', '', text, flags=re.IGNORECASE)
    return bool(re.search(r'\b(urgent|immediately|act now|expires? in|24 hours|30 minutes|'
                           r'final notice|last chance|account locked)\b', cleaned, re.IGNORECASE))

def has_authority_impersonation(text):
    return bool(re.search(r'\b(ceo|cfo|it support|law enforcement|government|irs|fbi|police)\b',
                           text, re.IGNORECASE))

def has_reward_bait(text):
    return bool(re.search(r'\b(you.?ve won|prize|gift card|congratulations|claim your reward)\b',
                           text, re.IGNORECASE))

def has_return_path_mismatch(text):
    from_match = re.search(r'From:.*?<([^>]+)>', text, re.IGNORECASE)
    rp_match = re.search(r'Return-Path:\s*<?([^\s>]+)>?', text, re.IGNORECASE)
    if from_match and rp_match:
        from_domain = from_match.group(1).split('@')[-1].lower().strip()
        rp_domain = rp_match.group(1).split('@')[-1].lower().strip()
        if from_domain and rp_domain and from_domain != rp_domain:
            return True
    return False

RULES = [
    ("RF1", "Sender-Domain Mismatch", 3, "Header",
     has_domain_mismatch,
     "Display name references a trusted brand/role but the actual From "
     "address domain does not match it."),
    ("RF2", "Fake Forwarded Chain", 2, "Header",
     has_forwarded_chain,
